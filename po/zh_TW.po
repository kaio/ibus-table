"If this is set to “single char”, only single\n"
"character candidates will be shown. If it is\n"
"set to “Phrase” candidates consisting of\n"
"several characters may be shown."
msgstr ""
"如果設定為 \"single char\"（單一字元），\n"
"則只會顯示單一字元的候選字。\n"
"如果設為「Phrase」，\n"
"則可能會顯示由多個字元組成的候選字。"

#: setup/main.py:910
msgid "Phrase"
msgstr "詞彙"

#: setup/main.py:911
msgid "Single Char"
