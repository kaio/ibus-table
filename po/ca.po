msgstr "Realment voleu restaurar tots els paràmetres predeterminats?"

#: setup/main.py:1686 setup/main.py:1897 setup/main.py:2306
msgid "Are you sure?"
msgstr "N'esteu segur?"

#: setup/main.py:1687 setup/main.py:1898 setup/main.py:2307 setup/main.py:3139
