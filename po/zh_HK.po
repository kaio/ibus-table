#: setup/main.py:443
msgid "Simplified Chinese before traditional"
msgstr "切換成簡體優先模式"

#. Translators: This is the setting to use both
#. simplified and traditional Chinese but prefer
#. traditional Chinese
#: setup/main.py:448
msgid "Traditional Chinese before simplified"
msgstr "切換成繁體優先模式"

